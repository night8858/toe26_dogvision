<!--
  机械臂测试模块
  ==============
  启动串口通信节点 + 终端测试节点 + 高层指令编排节点，
  直接在 roslaunch 终端中输入命令进行手动调试。
-->
<launch>

  <node name="arm_internation_node" pkg="dogvision_arm" type="Arm_internation_node"
        output="screen">
    <param name="hw_id"       value="0483:5740"/>
    <param name="baud_rate"   value="115200"/>
    <param name="pos_scale"   value="0.01"/>
    <param name="angle_scale" value="0.01"/>
  </node>

  <rosparam command="load" file="$(find dogvision_arm)/pos_set.yaml" ns="arm_mission_node"/>

  <node name="arm_mission_node" pkg="dogvision_arm" type="arm_mission_node"
        output="screen"/>

  <!-- 终端测试节点（在 roslaunch 终端中直接输入命令） -->
  <node name="arm_cmd_terminal_node" pkg="dogvision_arm" type="arm_cmd_terminal_node"
        output="screen"/>

</launch>

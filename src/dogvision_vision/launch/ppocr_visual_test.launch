<!--
  PP-OCR visual debugging launcher.
  Default input_path is empty, so this starts live camera visualization.
  Set input_path to a file or directory for offline image playback.
-->
<launch>
  <arg name="config_path" default="$(find-pkg-share dogvision_vision)/config/settings.json"/>
  <arg name="input_path" default=""/>
  <arg name="loop" default="false"/>
  <arg name="wait_ms" default="1000"/>
  <arg name="show_visual" default="true"/>
  <arg name="show_ocr_roi" default="true"/>
  <arg name="show_debug_panels" default="true"/>
  <arg name="yaml_path" default="$(find-pkg-share dogvision_vision)/data/ocr_output/ocr_results.yaml"/>
  <arg name="debug_snapshot_dir" default="$(find-pkg-share dogvision_vision)/data/ocr_debug"/>

  <node pkg="dogvision_vision" exec="ppocr_node" name="ppocr_node" output="screen">
    <param name="config_path" value="$(var config_path)" type="str"/>
    <param name="mode" value="visual_test" type="str"/>
    <param name="input_path" value="$(var input_path)" type="str"/>
    <param name="loop" value="$(var loop)" type="bool"/>
    <param name="wait_ms" value="$(var wait_ms)" type="int"/>
    <param name="show_visual" value="$(var show_visual)" type="bool"/>
    <param name="show_ocr_roi" value="$(var show_ocr_roi)" type="bool"/>
    <param name="show_debug_panels" value="$(var show_debug_panels)" type="bool"/>
    <param name="enable_keyboard_trigger" value="false" type="bool"/>
    <param name="yaml_path" value="$(var yaml_path)" type="str"/>
    <param name="debug_snapshot_dir" value="$(var debug_snapshot_dir)" type="str"/>
  </node>
</launch>

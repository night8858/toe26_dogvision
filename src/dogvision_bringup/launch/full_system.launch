<!--
  完整系统启动脚本
  同时启动机械臂控制（arm_control）和视觉处理（vision）两大子系统，
  集成了 YOLO 目标检测、PP-OCR 文字识别和机械臂交互，实现完整的"识别-决策-执行"闭环。
-->
<launch>
  <!-- ==================== 机械臂参数 ==================== -->
  <!-- USB 硬件 ID（VID:PID） -->
  <arg name="hw_id" default="0483:5740"/>
  <!-- 串口波特率 -->
  <arg name="baud_rate" default="115200"/>
  <!-- 串口端口号，留空自动搜索 -->
  <arg name="port" default=""/>
  <!-- 关节位置缩放系数 -->
  <arg name="pos_scale" default="0.01"/>
  <!-- 关节角度缩放系数 -->
  <arg name="angle_scale" default="0.01"/>
  <!-- 通信协议类型：compiled（预编译）或 raw（原始命令） -->
  <arg name="protocol" default="compiled"/>
  <!-- OCR 答案输出话题 -->
  <arg name="ocr_answer_topic" default="/ocr/answer"/>
  <!-- 机械臂任务配置文件路径 -->
  <arg name="mission_config" default="$(find-pkg-share dogvision_arm)/config/pos_set.yaml"/>

  <!-- ==================== 视觉系统参数 ==================== -->
  <!-- 视觉系统配置文件路径（JSON 格式） -->
  <arg name="config_path" default="$(find-pkg-share dogvision_vision)/config/settings.json"/>
  <!-- 调试模式开关 -->
  <arg name="debug" default="false"/>
  <!-- 是否显示图像窗口（默认跟随 debug 模式） -->
  <arg name="show_window" default="$(var debug)"/>
  <!-- 是否启用鱼眼图像去畸变 -->
  <arg name="enable_undistort" default="true"/>
  <!-- 是否保存检测图像 -->
  <arg name="save_images" default="true"/>
  <!-- 图像保存目录 -->
  <arg name="save_dir" default="$(find-pkg-share dogvision_vision)/data/yolorun"/>
  <!-- 共享相机图像话题 -->
  <arg name="image_topic" default="/camera/image_raw"/>
  <!-- 共享相机 frame_id -->
  <arg name="camera_frame_id" default="camera"/>
  <!-- 共享相机发布帧率 -->
  <arg name="camera_publish_rate" default="30.0"/>
  <!-- YOLO 是否启用键盘触发检测 -->
  <arg name="yolo_enable_keyboard_trigger" default="false"/>
  <!-- PP-OCR 运行模式：production（生产）/ test（测试）/ visual_test（可视化测试） -->
  <arg name="ppocr_mode" default="production"/>
  <!-- PP-OCR 是否显示可视化结果 -->
  <arg name="ppocr_show_visual" default="$(var debug)"/>
  <!-- PP-OCR 是否显示 OCR 感兴趣区域 -->
  <arg name="ppocr_show_ocr_roi" default="$(var debug)"/>
  <!-- PP-OCR 是否显示调试面板 -->
  <arg name="ppocr_show_debug_panels" default="$(var debug)"/>
  <!-- PP-OCR 是否启用键盘触发识别 -->
  <arg name="ppocr_enable_keyboard_trigger" default="true"/>
  <!-- PP-OCR 稳定识别后是否自动保存标注结果图 -->
  <arg name="ppocr_save_result_images" default="true"/>
  <!-- PP-OCR 自动结果图保存目录；留空时使用 debug_snapshot_dir/auto -->
  <arg name="ppocr_result_image_dir" default=""/>
  <!-- PP-OCR 自动结果图最多保留张数 -->
  <arg name="ppocr_max_result_images" default="30"/>
  <!-- OCR 结果 YAML 输出路径 -->
  <arg name="ocr_yaml_path" default="$(find-pkg-share dogvision_vision)/data/ocr_output/ocr_results.yaml"/>

  <!-- ==================== 包含子启动文件 ==================== -->
  <!-- 引入机械臂控制启动文件 -->
  <include file="$(find-pkg-share dogvision_arm)/launch/arm_control.launch">
    <arg name="hw_id" value="$(var hw_id)"/>
    <arg name="baud_rate" value="$(var baud_rate)"/>
    <arg name="port" value="$(var port)"/>
    <arg name="pos_scale" value="$(var pos_scale)"/>
    <arg name="angle_scale" value="$(var angle_scale)"/>
    <arg name="protocol" value="$(var protocol)"/>
    <arg name="ocr_answer_topic" value="$(var ocr_answer_topic)"/>
    <arg name="mission_config" value="$(var mission_config)"/>
  </include>

  <!-- 引入视觉处理启动文件（YOLO + PP-OCR） -->
  <include file="$(find-pkg-share dogvision_bringup)/launch/vision.launch">
    <arg name="config_path" value="$(var config_path)"/>
    <arg name="debug" value="$(var debug)"/>
    <arg name="show_window" value="$(var show_window)"/>
    <arg name="enable_undistort" value="$(var enable_undistort)"/>
    <arg name="save_images" value="$(var save_images)"/>
    <arg name="save_dir" value="$(var save_dir)"/>
    <arg name="image_topic" value="$(var image_topic)"/>
    <arg name="camera_frame_id" value="$(var camera_frame_id)"/>
    <arg name="camera_publish_rate" value="$(var camera_publish_rate)"/>
    <arg name="yolo_enable_keyboard_trigger" value="$(var yolo_enable_keyboard_trigger)"/>
    <arg name="ppocr_mode" value="$(var ppocr_mode)"/>
    <arg name="ppocr_show_visual" value="$(var ppocr_show_visual)"/>
    <arg name="ppocr_show_ocr_roi" value="$(var ppocr_show_ocr_roi)"/>
    <arg name="ppocr_show_debug_panels" value="$(var ppocr_show_debug_panels)"/>
    <arg name="ppocr_enable_keyboard_trigger" value="$(var ppocr_enable_keyboard_trigger)"/>
    <arg name="ppocr_save_result_images" value="$(var ppocr_save_result_images)"/>
    <arg name="ppocr_result_image_dir" value="$(var ppocr_result_image_dir)"/>
    <arg name="ppocr_max_result_images" value="$(var ppocr_max_result_images)"/>
    <arg name="ocr_yaml_path" value="$(var ocr_yaml_path)"/>
  </include>
</launch>

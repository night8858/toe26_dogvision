// OpenVINO模型路径和PPOCR模型路径
    "path":
    {
      "openvino_bin_file_path": "models/yolo/yolo/C2f-EMA_629_FP32/best.bin",
      "openvino_xml_file_path": "models/yolo/yolo/C2f-EMA_629_FP32/best.xml",
      "openvino_device": "CPU",

      "ppocr_det_model_bin_path": "models/ppocr/PP-OCRv5_server_det_openvino/inference.bin",
      "ppocr_det_model_xml_path": "models/ppocr/PP-OCRv5_server_det_openvino/inference.xml",
      "ppocr_rec_model_bin_path": "models/ppocr/PP-OCRv5_server_rec_openvino/inference.bin",
      "ppocr_rec_model_xml_path": "models/ppocr/PP-OCRv5_server_rec_openvino/inference.xml",

      "ppocr_det_model_path": "",
      "ppocr_rec_model_path": "",
      "ppocr_cls_model_path": "",

      "ppocr_dict_path": "models/ppocr/PP-OCRv5_server_rec_infer/inference.yml",
      "ppocr_allowed_chars_path": "models/ppocr/Dict/math_chars.txt"

    },

    "ocr_math_filter":
    {
      "use_grayscale": false,
      "roi_enabled": true,
      "roi_mode": "ratio",
      "roi_quadrant": "top_right",
      "roi_rect_ratio":
      {
        "x": 0.50,
        "y": 0.00,
        "w": 0.50,
        "h": 0.50
      },
      "left_roi_rect_ratio":
      {
        "x": 0.00,
        "y": 0.00,
        "w": 0.50,
        "h": 0.50
      },
      "right_roi_rect_ratio":
      {
        "x": 0.50,
        "y": 0.00,
        "w": 0.50,
        "h": 0.50
      },
      "min_surround_white_ratio": 0.50,
      "surround_margin_ratio": 0.50,
      "white_s_max": 110,
      "white_v_min": 50
    },

    "NCHW":
    {
      "batch_size": 1,
      "C": 3,
      "W": 640,
      "H": 640
      
    },
  
    "img":
    {
      "type种类: 0-rgb 1-bgr 2-yuv 3-yv12 4-bayerrg ...":"",
      "type": 0,
      "width": 1920,
      "height": 1080
    },
  
    "thresh":
    {
        "nms_thresh": 0.2,
        "bbox_conf_thresh": 0.6,
        "merge_thresh": 0.8,
        "max_wellid_distance": 8
    },

    "output_save":
    {
      "save_ppocr_video": true,
      "ppocr_video_save_dir": "src/dogvision_vision/data/ocr_output/video",
      "ppocr_video_fps": 20.0,
      "max_ppocr_videos": 10,
      "save_ocr_result_images": true,
      "ocr_result_image_dir": "src/dogvision_vision/data/ocr_debug/auto",
      "max_ocr_result_images": 30,
      "save_yolo_test_video": true
    },

    //类别数量设置
    "nums":
    {
        "classes": 4,
        "cls0":"food",
        "cls1":"tool",
        "cls2":"medicine",
        "cls3":"instrument"
        
    }

}
  

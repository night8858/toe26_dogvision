# ======================
# ROS2 / colcon 特定规则
# ======================
# colcon 工作空间构建、安装和日志目录
build/
install/
log/

# 旧 ROS1/catkin 工作空间遗留目录
devel/
.catkin_workspace
.catkin_tools/

# 编译命令数据库（通常由编辑器生成，无需版本控制）
compile_commands.json

# 日志（通常放在用户主目录，但在工作区内也避免误提交）
logs/
*.log

#vscode生成的文件
.vscode/


#codex的生成文件
.agents/
.codex/

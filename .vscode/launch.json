{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ROS2: Debug yolo_node (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "/home/waterking/my_ROS/toe26_dogvision",
      "program": "/home/waterking/my_ROS/toe26_dogvision/install/dogvision_vision/lib/dogvision_vision/yolo_node",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "environment": [
        {
          "name": "RCUTILS_COLORIZED_OUTPUT",
          "value": "1"
        }
      ],
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}

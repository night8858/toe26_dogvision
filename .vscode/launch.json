{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ROS: Debug yolo_node (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "/home/toe/toe26_dogvision",
      "program": "/home/toe/toe26_dogvision/devel/lib/dogvision26/yolo_node",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "environment": [
        {
          "name": "ROS_LOG_DIR",
          "value": "/tmp/ros_logs"
        }
      ],
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}